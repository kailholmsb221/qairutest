{
  "name": "@campuslive/contracts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./openapi.yaml": "./openapi.yaml"
  },
  "scripts": {
    "gen": "openapi-typescript openapi.yaml -o src/types.gen.ts --alphabetize --enum-values",
    "build": "pnpm gen",
    "check": "openapi-typescript openapi.yaml -o /tmp/types.check.ts && node scripts/check.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
