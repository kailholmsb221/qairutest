{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "building-a.json",
  "type": "object",
  "required": ["building", "name", "timezone", "viewBox", "floors"],
  "additionalProperties": false,
  "properties": {
    "building": { "type": "string", "pattern": "^[A-Z0-9]+$" },
    "name": { "type": "string", "minLength": 1 },
    "timezone": { "type": "string", "minLength": 1 },
    "viewBox": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
    "floors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "planKey", "name", "rooms"],
        "additionalProperties": false,
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "planKey": { "type": "string", "pattern": "^a-f[0-9]+$" },
          "name": { "type": "string" },
          "rooms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "code", "name", "names", "mapLabel", "type", "mapType", "wing", "schedulable", "capacity", "area", "bbox", "label", "path"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "code": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
                "name": { "type": "string", "minLength": 1 },
                "names": {
                  "type": "object",
                  "required": ["ru", "kk", "en"],
                  "additionalProperties": false,
                  "properties": { "ru": { "type": "string", "minLength": 1 }, "kk": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
                },
                "mapLabel": { "type": "string" },
                "type": { "enum": ["lecture", "seminar", "lab", "coworking", "admin", "service", "void"] },
                "mapType": { "enum": ["office", "class", "hall", "corridor", "wc", "stairs", "lift", "service", "tech", "lobby", "cafe", "storage"] },
                "wing": { "enum": ["west", "east", "core"] },
                "schedulable": { "type": "boolean" },
                "capacity": { "type": ["integer", "null"], "minimum": 1 },
                "area": { "type": ["number", "null"] },
                "bbox": {
                  "type": "object",
                  "required": ["x", "y", "w", "h"],
                  "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "w": { "type": "number", "exclusiveMinimum": 0 }, "h": { "type": "number", "exclusiveMinimum": 0 } }
                },
                "label": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
                "path": { "type": "string", "pattern": "^M .* Z$" }
              }
            }
          }
        }
      }
    }
  }
}
