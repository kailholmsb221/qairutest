{
  "name": "campuslive",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter @campuslive/web e2e",
    "map:build": "pnpm --filter @campuslive/map-data build",
    "vector:build": "pnpm --filter @campuslive/map-data build",
    "contracts:gen": "pnpm --filter @campuslive/contracts gen",
    "seed": "cd services/api && go run ./cmd/seed",
    "api": "cd services/api && go run ./cmd/api",
    "db:up": "docker compose -f infra/docker-compose.yml up -d postgres",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "demo": "node infra/demo/demo.mjs",
    "demo:script": "node infra/demo/demo-script.mjs"
  },
  "devDependencies": {
    "turbo": "^2.10.13",
    "typescript": "^5.9.3"
  }
}
