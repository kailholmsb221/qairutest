# Local TLS front: https://localhost:8443 → web, /api/* → api (SSE needs flush_interval -1)
localhost:8443 {
	tls internal

	handle /api/* {
		reverse_proxy api:8080 {
			flush_interval -1
			transport http {
				read_timeout 0
			}
		}
	}
	handle /healthz {
		reverse_proxy api:8080
	}
	handle /readyz {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy web:3000
	}
}
