# ---- compose host ports (infra/docker-compose.yml)
POSTGRES_PORT=5434
API_PORT=8090
WEB_PORT=3000

# ---- api (services/api)
PORT=8090
DATABASE_URL=postgres://campuslive:campuslive@localhost:5434/campuslive?sslmode=disable
CORS_ORIGINS=http://localhost:3000
CLOCK_MODE=real            # real | fixed | offset
CLOCK_FIXED_AT=            # e.g. 2026-09-08T10:47:00+05:00 (fixed)
CLOCK_OFFSET=0s            # e.g. -3h20m (offset)
ADMIN_API_KEY=
SOON_WINDOW=10m
ENDING_WINDOW=5m
NEXT_HORIZON=90m
LOG_LEVEL=info
MIGRATE_ON_START=true
SEED_ON_START=false
MAP_PATH=../../packages/map-data/building-a.json
APP_VERSION=dev

# ---- web (apps/web)
API_URL=http://localhost:8090             # server-side (RSC) fetches
NEXT_PUBLIC_API_URL=http://localhost:8090 # browser fetches + EventSource
NEXT_PUBLIC_ADMIN_API_KEY=                # DemoAdminPanel (demo only!)
